{
  "name": "inteldoc-view",
  "private": true,
  "workspaces": [
    "infra",
    "api",
    "ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "deploy": "cd infra && npx cdk deploy --all --outputs-file cdk-outputs.json",
    "dev:ui": "cd ui && npm run dev",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
